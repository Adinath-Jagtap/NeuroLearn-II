# NeuroLearn 2.0 — Environment Variables
# Copy this file to .env and fill in your values

# --- Flask ---
FLASK_SECRET_KEY=your_random_secret_key_here_change_this

# --- Firebase (Firestore REST API) ---
FIREBASE_PROJECT_ID=neurolearn-d9491
FIREBASE_API_KEY=your_firebase_api_key_here

# --- Groq AI (LLM for AI Companion & Game Generation) ---
GROQ_API_KEY=your_groq_api_key_here
COMPANION_MODEL=llama-3.3-70b-versatile

# --- Resend (Email Alerts, SOS, Reports) ---
RESEND_API_KEY=your_resend_api_key_here
RESEND_FROM_EMAIL=NeuroLearn <onboarding@resend.dev>

# --- HuggingFace (Optional — for advanced AI features) ---
HF_TOKEN=your_huggingface_token_here

# --- Deployment ---
PORT=8000